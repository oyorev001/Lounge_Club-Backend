{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "sqlConnection": ""
  },
  "DatabaseSettings": {
    "DBProvider": "postgresql"
  },
  "JwtSettings": {
    "ValidIssuer": "LoungeClubsApi-API",
    "ValidAudience": "LoungeClubsApi-Client",
    "Secret": "",
    "TokenValidityInMinutes": 3600,
    "RefreshTokenValidityInDays": 7
  },
  "AppSettings": {
    "AppUrl": "https://localhost:5001",
    "PortalUrl": "http://localhost:5173",
    "LevyDueDays": 30
  },
  "Paystack": {
    "BaseUrl": "https://api.paystack.co",
    "SecretKey": "",
    "PublicKey": ""
  },
  "Storage": {
    "Provider": "local",
    "S3": {
      "Endpoint": "",
      "Bucket": "",
      "AccessKey": "",
      "SecretKey": "",
      "PublicBaseUrl": ""
    }
  },
  "MailSettings": {
    "Mail": "noreply@oyolc.gov.ng",
    "DisplayName": "Oyo State Lounge & Clubs Portal",
    "Password": "",
    "Host": "smtp.gmail.com",
    "Port": 587
  }
}
